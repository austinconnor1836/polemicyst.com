# Local environment variables (template)
#
# Create two files locally (NOT committed):
# - .env
# - .env.local
#
# Then paste the needed variables from below and fill in secrets.
#
# --- Database (local dev, or Neon in prod) ---
# In prod (Neon): use the POOLED endpoint (?pgbouncer=true, hostname ends with -pooler).
# In local dev: use docker-compose Postgres at localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipfire
# Direct (non-pooled) URL used by `prisma migrate`. In prod: Neon direct endpoint
# (same host without -pooler). In local dev: same as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipfire
#
# --- Redis (BullMQ) — local dev, or Upstash in prod ---
# Local dev: docker-compose redis at localhost:6379.
# Prod (Upstash): TCP TLS endpoint. Set REDIS_PASSWORD + REDIS_TLS=true.
# REDIS_PASSWORD is passed to ioredis only when set (in-cluster Redis has no auth).
# REDIS_TLS enables TLS (ioredis `tls: {}`). Required for Upstash; leave off for in-cluster.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
#
# --- Object storage ---
# STORAGE_PROVIDER picks the adapter: 'r2' (Cloudflare R2) or 's3' (AWS S3).
# Default: 's3'. Auto-detected as 'r2' if R2_ACCOUNT_ID is set.
STORAGE_PROVIDER=s3
#
# --- Cloudflare R2 (when STORAGE_PROVIDER=r2) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override; default is https://<accountId>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional; only if the R2 bucket is exposed as a public pub-<hash>.r2.dev URL.
R2_PUBLIC_BASE_URL=
#
# --- Optional: AWS (only when STORAGE_PROVIDER=s3 or during S3→R2 migration) ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to 'true' to use S3 Transfer Acceleration (bucket must have it enabled)
S3_TRANSFER_ACCELERATION=false
#
# --- Optional: model APIs (only if using external scoring/models) ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
# Acts as the fallback default provider; users can set their own preference in-app.
GEMINI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# --- Auth secrets ---
# NextAuth JWT secret (used for encoding/decoding session JWTs, including mobile Bearer tokens)
NEXTAUTH_SECRET=

# --- Mobile auth ---
# Apple Sign-In: bundle ID used as audience for identity token verification
APPLE_CLIENT_ID=com.polemicyst.app
# Google iOS OAuth client ID (created in Google Cloud Console for iOS bundle)
GOOGLE_IOS_CLIENT_ID=

# --- Optional: auth debug logging (DANGER: may log OAuth tokens if enabled) ---
# Default is off. Only set this temporarily for local debugging and avoid sharing logs.
NEXTAUTH_DEBUG=false

# --- Optional: auth allowlist (lockdown mode) ---
# When enabled, only the allowed emails/providers can sign in.
AUTH_ALLOWLIST_ENABLED=true
# Comma-separated list of allowed emails (lower/upper case ok).
AUTH_ALLOWED_EMAILS=
# Comma-separated list of allowed providers (default used in code: google).
AUTH_ALLOWED_PROVIDERS=google

# --- Admin (cost dashboard access) ---
ADMIN_EMAIL=aconnor731@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=aconnor731@gmail.com

# --- Stripe (billing & subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Per-plan, per-interval price IDs (Stripe dashboard → Products → Pricing).
# Set both MONTHLY and ANNUAL for each paid tier to enable annual billing.
# Creator tier
STRIPE_CREATOR_MONTHLY_PRICE_ID=
STRIPE_CREATOR_ANNUAL_PRICE_ID=
# Pro tier
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Agency tier
STRIPE_AGENCY_MONTHLY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=
#
# DEPRECATED — legacy single-price vars (still read as fallback for existing subscribers).
# Prefer the per-interval vars above for new deployments.
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# --- Rate limiting (Upstash Redis) ---
# When both are set, the rate limiter uses Upstash (shared across instances).
# When unset, falls back to an in-memory per-process limiter — fine for dev,
# NOT safe in multi-instance production deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error tracking (Sentry) ---
# DSN for client-side (browser) Sentry. Safe to expose — Sentry DSNs are public by design.
# When unset, Sentry.init is a runtime no-op and no events are reported.
NEXT_PUBLIC_SENTRY_DSN=
# DSN for server-side (Next.js server runtime + workers) Sentry. Falls back to NEXT_PUBLIC_SENTRY_DSN
# in the Next.js config; workers read SENTRY_DSN directly. Same project as the client DSN is fine.
SENTRY_DSN=
# Auth token used by the build-time Sentry webpack plugin to upload source maps to Sentry.
# Required only for production builds where you want symbolicated stack traces. Get from
# https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/. When unset,
# source-map upload is skipped so local/dev builds never fail on missing credentials.
SENTRY_AUTH_TOKEN=
# Sentry org + project slugs used by the webpack plugin. Required only when SENTRY_AUTH_TOKEN is set.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Instagram transcript resolver ---
# Instagram has NO native transcript surface (Meta Graph API doesn't expose one,
# and all anonymous scrape paths were killed in the June 2026 doc_id migration).
# Our resolver logs in via `instagram-private-api` using a persisted session
# state produced by `scripts/generate-ig-state.ts`, calls `media.info(mediaId)`
# to get the signed CDN mp4 URL, then hands that URL to the existing Whisper
# transcription worker.
#
# Session state backends, in priority order (see shared/lib/instagram-session-store.ts):
#   1. R2 (primary post-cutover):
#        R2_ENDPOINT (or R2_ACCOUNT_ID) + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY +
#        IG_SESSION_R2_BUCKET (or R2_BUCKET).
#   2. Neon KeyValueStore table (falls back automatically when R2 unset).
#   3. Local filesystem via INSTAGRAM_SESSION_STATE_PATH (dev only; wiped on
#      Vercel / Fly Machines restarts).
# When NONE of these have a session state, the IG import endpoint returns 503.
# Optional: SESSION_ENCRYPTION_KEY = 32-byte hex or base64 → AES-256-GCM at rest.
INSTAGRAM_SESSION_STATE_PATH=
IG_SESSION_R2_BUCKET=
SESSION_ENCRYPTION_KEY=

# --- Analytics (PostHog) ---
# Both keys are optional — when unset, all PostHog calls are no-ops so dev/test
# environments never touch PostHog. The cookie banner (clipfire-cookie-consent
# localStorage key) ALSO gates the JS SDK: without `accepted`, posthog-js is
# never loaded.
#
# Server-side project API key (used by posthog-node in route handlers).
POSTHOG_API_KEY=
# Server host override (defaults to https://us.i.posthog.com).
POSTHOG_HOST=
# Client-side project key (loaded into the browser bundle).
NEXT_PUBLIC_POSTHOG_KEY=
# Client-side host override (defaults to https://us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=

# --- iOS Crashlytics (Firebase) ---
# The iOS app loads `GoogleService-Info.plist` from the app bundle at startup. The file
# is NOT committed to the repo — download it from the Firebase console for the
# `com.clipfire.app` iOS app and place it at `ios/Supporting/GoogleService-Info.plist` for
# local builds, and ship it via CI secrets (base64-encoded) for TestFlight/App Store builds.
# When the plist is absent, FirebaseApp.configure() logs a warning and Crashlytics stays disabled —
# the app still launches and runs normally.
